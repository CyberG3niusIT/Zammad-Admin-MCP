# Remote Zammad instances must use HTTPS; HTTP is accepted only for localhost/loopback.
# Zammad instance root or API root, for example https://support.example.net
ZAMMAD_URL=

# Create a dedicated API token in Zammad. Do not commit the real value.
ZAMMAD_HTTP_TOKEN=

# Alternative HTTP Basic authentication. A configured token takes precedence.
ZAMMAD_HTTP_USERNAME=
ZAMMAD_HTTP_PASSWORD=

# Optional write-only credentials; tool payloads may refer to these names without
# sending the secret values through the MCP conversation.
# ZAMMAD_SECRET_EMAIL_INBOUND_PASSWORD=
# ZAMMAD_SECRET_EMAIL_OUTBOUND_PASSWORD=
